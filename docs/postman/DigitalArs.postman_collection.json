{
	"info": {
		"_postman_id": "digitalars-api-collection",
		"name": "DigitalArs API",
		"description": "Colección completa de la API de DigitalArs — Billetera Virtual.\n\nIncluye autenticación JWT, gestión de usuarios, cuentas y transacciones.\n\n## Uso rápido\n1. Ejecuta \"Login Admin\" o \"Login User\" para obtener un token automáticamente.\n2. Las variables `adminToken` y `userToken` se asignan vía scripts post-respuesta.\n3. Todos los endpoints protegidos usan el header `Authorization: Bearer {{userToken}}` o `{{adminToken}}`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5016",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"description": "Endpoints de autenticación y obtención de tokens JWT.",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('adminToken', jsonData.token);",
									"    pm.test('Token de admin asignado correctamente', function () {",
									"        pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@digitalars.com\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario administrador y almacena el token JWT en la variable `adminToken`."
					}
				},
				{
					"name": "Login User (Juan Perez)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('userToken', jsonData.token);",
									"    pm.test('Token de usuario asignado correctamente', function () {",
									"        pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"juan.perez@digitalars.com\",\n  \"password\": \"User123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario regular Juan Perez y almacena el token JWT en la variable `userToken`."
					}
				},
				{
					"name": "Login - Credenciales inválidas (401)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@digitalars.com\",\n  \"password\": \"PasswordIncorrecto\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Caso de prueba: credenciales incorrectas. Debe devolver 401 Unauthorized."
					}
				}
			]
		},
